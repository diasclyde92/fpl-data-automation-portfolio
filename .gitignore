# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment variables & secrets
.env
.env.*
!.env.example

# Data storage (raw, processed, databases)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.db
*.sqlite3

# Reports & exports
reports/exports/*
!reports/exports/.gitkeep
*.xlsx
*.pdf
*.csv

# Logs
logs/
*.log

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
